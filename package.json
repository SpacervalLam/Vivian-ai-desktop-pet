{
  "name": "vivian",
  "version": "1.0.1",
  "description": "Vivian AI Desktop Pet - Rust + Tauri + React",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:frontend": "node scripts/run-tests.mjs --frontend",
    "test:desktop": "node scripts/run-tests.mjs --live",
    "test:rust": "node scripts/run-rust-tests.mjs",
    "test:windows-integration": "node scripts/run-rust-tests.mjs --windows-integration",
    "test:contracts": "cargo test --locked --manifest-path src-tauri/runtime-contracts/Cargo.toml -j 1",
    "eval:companion": "node scripts/evaluate-companion.mjs",
    "eval:prompts": "node scripts/evaluate-prompts.mjs",
    "eval:prompts:live": "node scripts/evaluate-prompts.mjs --live",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:contracts",
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-apartment-plugin.mjs --core",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:toast-dedup": "node scripts/toast-dedup.test.ts",
    "test:flee-plan": "node scripts/flee-plan.test.ts",
    "check:tap-anger": "node scripts/check-tap-anger.mjs",
    "check:agent-track": "esbuild plugins/3d-apartment/tools/room/check-agent-track.ts --bundle --platform=node --format=esm --outfile=tmp/check-agent-track.mjs --log-level=warning && node tmp/check-agent-track.mjs",
    "check:world-route": "node plugins/3d-apartment/tools/room/check-world-route.mjs",
    "build:apartment": "npm run build --workspace @vivian/3d-apartment",
    "package:small": "node scripts/package-small.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.6",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "i18next": "^23.16.0",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.21.5",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "workspaces": [
    "plugins/3d-apartment"
  ]
}
