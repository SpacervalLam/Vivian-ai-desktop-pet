import { buildExteriorGround, buildStreetscape, buildApartmentShell, buildConvenienceStore, buildStreetscapeRipples, buildApartmentEaveDrips, STRS, FLOORS, APT_X0, APT_X1, APT_ZN, APT_ZB, APT_WALL_BOXES, APT_CORRIDOR_N } from './anime/exterior';
